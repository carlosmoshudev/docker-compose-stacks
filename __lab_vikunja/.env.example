# ============================================================
# Vikunja stack - .env.example
# ============================================================

COMPOSE_PROJECT_NAME=lab_vikunja

TZ=Europe/Madrid
APPDATA_DIR=/srv/containers/pro/__lab_vikunja/data

VIKUNJA_HOST_PORT=3456
VIKUNJA_CONTAINER_PORT=3456
VIKUNJA_PUBLIC_URL=http://cali-home:3456/

VIKUNJA_SERVICE_SECRET=replace_with_vikunja_service_secret

VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_USER=vikunja
VIKUNJA_DB_PASSWORD=replace_with_vikunja_db_password
