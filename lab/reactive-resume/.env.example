# ============================================================
# Reactive Resume LAB stack - .env.example
# ============================================================

COMPOSE_PROJECT_NAME=lab_reactive_resume

TZ=Europe/Madrid
APPDATA_DIR=/srv/containers/pro/lab/reactive-resume/data

REACTIVE_RESUME_HOST_PORT=3015
REACTIVE_RESUME_CONTAINER_PORT=3000
REACTIVE_RESUME_APP_URL=http://cali-home:3015

REACTIVE_RESUME_DB_NAME=reactive_resume
REACTIVE_RESUME_DB_USER=reactive_resume
REACTIVE_RESUME_DB_PASSWORD=replace_with_reactive_resume_db_password

REACTIVE_RESUME_AUTH_SECRET=replace_with_32_byte_auth_secret
REACTIVE_RESUME_ENCRYPTION_SECRET=replace_with_32_byte_encryption_secret

REACTIVE_RESUME_DISABLE_SIGNUPS=false
REACTIVE_RESUME_DISABLE_EMAIL_AUTH=false
REACTIVE_RESUME_DISABLE_IMAGE_PROCESSING=false

REACTIVE_RESUME_S3_ACCESS_KEY_ID=replace_with_seaweedfs_access_key
REACTIVE_RESUME_S3_SECRET_ACCESS_KEY=replace_with_seaweedfs_secret_key
REACTIVE_RESUME_S3_BUCKET=reactive-resume

