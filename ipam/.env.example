# ============================================================
# IPAM stack - .env.example
# ============================================================

COMPOSE_PROJECT_NAME=pro_ipam

TZ=Europe/Madrid
APPDATA_DIR=/srv/containers/pro/ipam/data

IPAM_HOST_PORT=8089
IPAM_CONTAINER_PORT=80
IPAM_SCAN_INTERVAL=1h
IPAM_DISABLE_INSTALLER=false

IPAM_DB_NAME=phpipam
IPAM_DB_USER=phpipam
IPAM_DB_PASSWORD=replace_with_ipam_db_password
IPAM_DB_ROOT_PASSWORD=replace_with_ipam_db_root_password

