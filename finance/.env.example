# ============================================================
# Finance stack - .env.example
# ============================================================

COMPOSE_PROJECT_NAME=pro_finance

TZ=Europe/Madrid
APPDATA_DIR=/srv/containers/pro/finance/data

FIREFLY_HOST_PORT=8088
FIREFLY_CONTAINER_PORT=8080
FIREFLY_APP_URL=http://cali-home:8088
FIREFLY_SITE_OWNER=replace_with_owner_email
FIREFLY_APP_KEY=replace_with_exactly_32_random_chars
FIREFLY_STATIC_CRON_TOKEN=replace_with_exactly_32_random_chars

FIREFLY_DB_NAME=firefly
FIREFLY_DB_USER=firefly
FIREFLY_DB_PASSWORD=replace_with_firefly_db_password
FIREFLY_DB_ROOT_PASSWORD=replace_with_firefly_db_root_password

