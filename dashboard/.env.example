# ============================================================
# STACK: Dashboard [PRODUCCION]                .env.example
# ------------------------------------------------------------
# - Homepage: https://gethomepage.dev/
# - Homarr:   https://homarr.dev/
# - Glances:  https://nicolargo.github.io/glances/
# ============================================================
COMPOSE_PROJECT_NAME=pro_dashboard
# ------------------------------------------------------------
# Variables comunes
TZ=Europe/Madrid
APPDATA_DIR=/srv/containers/pro/dashboard/data
SERVER_HOSTNAME=your-server-hostname
SOCK=/var/run/docker.sock
DRIVES_PATH=/srv/storage
PUID=1000
PGID=1000
# ------------------------------------------------------------
# Homepage
HOMEPAGE_ALLOWED_HOSTS=*
HOMEPAGE_VAR_FAMILY_CALENDAR_ICS=https://calendar.google.com/calendar/ical/example/basic.ics
HOMEPAGE_VAR_PORTAINER_API_KEY=replace_with_portainer_api_key
HOMEPAGE_VAR_ADGUARD_USERNAME=replace_with_adguard_username
HOMEPAGE_VAR_ADGUARD_PASSWORD=replace_with_adguard_password
# ------------------------------------------------------------
# Homarr
HOMARR_KEY=replace_with_secure_key
# ------------------------------------------------------------
# Puertos
HOMEPAGE_HOST_PORT=3000
HOMEPAGE_CONTAINER_PORT=3000
HOMARR_HOST_PORT=7575
HOMARR_CONTAINER_PORT=7575
GLANCES_HOST_WEB_PORT=61208
GLANCES_CONTAINER_WEB_PORT=61208
GLANCES_HOST_API_PORT=61209
GLANCES_CONTAINER_API_PORT=61209
